# Bappa Mode Environment Variables
# Copy to .env and fill in for your environment

# ── DATABASE (Neon DB / PostgreSQL) ────────────────────────
# Get your Neon DB connection string from the Neon Console (https://console.neon.tech)
# Pooled connection string (recommended for serverless / Next.js):
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct connection string:
# DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── IMAGE STORAGE ──────────────────────────────────────────
# "local" = stores in public/uploads/ (development)
# "s3"    = requires AWS_* vars below (production)
IMAGE_STORAGE_PROVIDER="local"

# S3 (optional — only needed if IMAGE_STORAGE_PROVIDER=s3)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="ap-south-1"
# AWS_S3_BUCKET="bappa-mode-uploads"

# ── GAMEPLAY CONFIG ────────────────────────────────────────
# Configurable check-in radius in meters (default: 150)
CHECKIN_RADIUS_METERS=150

# Duplicate pandal detection radius in meters (default: 100)
DUPLICATE_PANDAL_RADIUS_METERS=100

# Set to "true" to allow demo mode check-ins without GPS verification
ALLOW_DEMO_MODE=true

# ── APP ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEMO_MODE_DEFAULT=false
NEXT_PUBLIC_CARTO_API_KEY="cb1_2kgj_1_456d4770cf6511639e1b189b"

# ── ADMIN (Phase 2) ────────────────────────────────────────
# Server-side only — NEVER expose to browser
ADMIN_TOKEN="bappa-admin-secret"
ADMIN_PASSWORD="bappa-admin"