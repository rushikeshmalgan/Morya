# Database (SQLite default for zero-config development)
DATABASE_URL="file:./dev.db"

# Image Storage Provider ("local" or "s3")
IMAGE_STORAGE_PROVIDER="local"

# S3 Configuration (optional, only when IMAGE_STORAGE_PROVIDER="s3")
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="ap-south-1"
# AWS_S3_BUCKET=""

# Game Rules
CHECKIN_RADIUS_METERS=150
DUPLICATE_PANDAL_RADIUS_METERS=100
ALLOW_DEMO_MODE=true

# Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── ADMIN (server-side only — never prefix with NEXT_PUBLIC_) ──
# ADMIN_TOKEN="change-me-before-production"
# ADMIN_PASSWORD="change-me-before-production"
